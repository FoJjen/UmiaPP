<Window x:Class="UmiaPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UmiaPP"
        xmlns:vm="clr-namespace:UmiaPP.ViewModels"
        xmlns:views="clr-namespace:UmiaPP.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="820" Width="1360" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ProjectListViewModel}">
            <views:ProjectListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActiveProjectViewModel}">
            <views:ActiveProjectView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="UMIA" Foreground="{DynamicResource PrimaryBrush}" FontSize="23" FontWeight="Bold"/>
                    <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="15,0"/>
                    <TextBlock Text="{DynamicResource AppTitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ActiveProjectTitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="⚙" Command="{Binding OpenSettingsCommand}" Style="{StaticResource IconButton}" FontSize="20" ToolTip="{DynamicResource Settings}" AutomationProperties.Name="{DynamicResource Settings}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
