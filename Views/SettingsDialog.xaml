<Window x:Class="UmiaPP.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inställningar" Width="470" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,22"/>
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="16">
            <StackPanel>
                <TextBlock Text="{DynamicResource LanguageLabel}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ComboBox Height="36" SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Tag">
                    <ComboBoxItem Content="{DynamicResource Swedish}" Tag="sv-SE"/>
                    <ComboBoxItem Content="{DynamicResource English}" Tag="en-US"/>
                </ComboBox>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="16" Margin="0,0,0,0">
            <StackPanel>
                <TextBlock Text="Tema" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="240" Height="36" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Margin="0,0,8,0"/>
                    <Button Content="Redigera..." Command="{Binding OpenThemeEditorCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Padding="16" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource DatabaseLabel}" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource LocalSqlite}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                <TextBlock Text="{DynamicResource CloudSyncStatus}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{DynamicResource Close}" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
            <Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>