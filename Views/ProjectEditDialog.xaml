<Window x:Class="UmiaPP.Views.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UmiaPP.ViewModels"
        Title="{Binding Title}" Width="600" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,22"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,12,14"><TextBlock Text="Projektnamn *" Margin="0,0,0,5"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,14"><TextBlock Text="Projektnummer *" Margin="0,0,0,5"/><TextBox Text="{Binding ProjectNumber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,14"><TextBlock Text="Beställare" Margin="0,0,0,5"/><TextBox Text="{Binding Client, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Grid.Row="2" Margin="0,0,12,14"><TextBlock Text="Entreprenadform" Margin="0,0,0,5"/><ComboBox Height="36" ItemsSource="{Binding ContractTypes}" SelectedItem="{Binding ContractType}"/></StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,14"><TextBlock Text="Status" Margin="0,0,0,5"/><ComboBox Height="36" ItemsSource="{Binding ProjectStatuses}" SelectedItem="{Binding Status}"/></StackPanel>
            <StackPanel Grid.Row="3" Margin="0,0,12,14"><TextBlock Text="Teknikområde" Margin="0,0,0,5"/><ComboBox Height="36" ItemsSource="{Binding Disciplines}" SelectedItem="{Binding Discipline}"/></StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="12,0,0,14"><TextBlock Text="Skapat datum" Margin="0,0,0,5"/><DatePicker Height="36" SelectedDate="{Binding CreatedDate}"/></StackPanel>
            <StackPanel Grid.Row="4" Grid.ColumnSpan="2"><TextBlock Text="Beskrivning" Margin="0,0,0,5"/><TextBox Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Avbryt" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
            <Button Content="Spara projekt" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>