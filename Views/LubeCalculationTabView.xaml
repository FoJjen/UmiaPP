<UserControl x:Class="UmiaPP.Views.LubeCalculationTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:UmiaPP.Converters" xmlns:views="clr-namespace:UmiaPP.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/LubeTableStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DifferensRowBrushConverter x:Key="DifferensRowBrush"/>
        <converters:KoptButtonTextConverter x:Key="KoptButtonText"/>
        <Style x:Key="RightAlignCell" TargetType="TextBlock" BasedOn="{StaticResource CompactLubeNumericText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="RightAlignEdit" TargetType="TextBox" BasedOn="{StaticResource CompactLubeNumericEdit}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="SakvaraReportRow" TargetType="DataGridRow" BasedOn="{StaticResource CompactLubeGridRow}">
        </Style>
        <Style x:Key="SakvaraRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SakvaraReportRow}">
            <Setter Property="BorderBrush" Value="{Binding Differens, Converter={StaticResource DifferensRowBrush}}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Differens}" Value="0">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SakvaraReportHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactLubeGridHeader}">
        </Style>
        <Style x:Key="SakvaraReportCell" TargetType="DataGridCell" BasedOn="{StaticResource CompactLubeGridCell}">
        </Style>
        <Style x:Key="SakvaraReportGrid" TargetType="DataGrid" BasedOn="{StaticResource CompactLubeDataGrid}">
            <Setter Property="RowStyle" Value="{StaticResource SakvaraReportRow}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource SakvaraReportHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource SakvaraReportCell}"/>
        </Style>
        <Style x:Key="ProductCodeChangedCell" TargetType="DataGridCell" BasedOn="{StaticResource SakvaraReportCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProduktkodChanged}" Value="True">
                    <Setter Property="Background" Value="#FFF8E1"/>
                    <Setter Property="Foreground" Value="#5D4037"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SupplierChangedCell" TargetType="DataGridCell" BasedOn="{StaticResource SakvaraReportCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLeverantorChanged}" Value="True">
                    <Setter Property="Background" Value="#FFF8E1"/>
                    <Setter Property="Foreground" Value="#5D4037"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Button x:Name="ImportProductionCalculationButton"
            Grid.Column="0"
            Content="{DynamicResource ImportLubeBtn}"
            Command="{Binding ImportLubeExcelCommand}"
            Style="{StaticResource PrimaryButton}"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Visibility="Visible"
            ToolTip="{DynamicResource ImportLubeBtn}"
            AutomationProperties.Name="{DynamicResource ImportLubeBtn}"/>
    <TextBox Grid.Column="2"
             Width="300"
             Margin="16,0,0,0"
             HorizontalAlignment="Right"
             VerticalAlignment="Center"
             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource SearchTextBox}"
             Tag="{DynamicResource FilterPlaceholder}"
             ToolTip="{DynamicResource FilterPlaceholder}"
             AutomationProperties.Name="{DynamicResource FilterPlaceholder}"/>
</Grid>
        <Grid Grid.Row="1" Margin="0,16,0,0">
        <TabControl SelectedIndex="{Binding SelectedLubeTabIndex}">
            <!-- 1. Kalkylsammandrag (Exakt som Bild 2) -->
            <TabItem Header="{DynamicResource SubTabSammandrag}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Visible">
                    <StackPanel>
                    <Border Padding="10" Background="White" BorderBrush="Black" BorderThickness="1" Language="sv-SE">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Arial"/><Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Foreground" Value="Black"/><Setter Property="Margin" Value="4,3"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="ÄTA – separat sammanställning och utfall" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="{Binding AtaStatus}"/>
                            <UniformGrid Columns="2">
                                <TextBlock Text="ÄTA arbetstid (h)"/><TextBlock Text="{Binding Outcome.Totals.WorkHours, StringFormat=N2}" TextAlignment="Right"/>
                                <TextBlock Text="ÄTA intäkt (kr)"/><TextBlock Text="{Binding Outcome.Revenue, StringFormat=N0}" TextAlignment="Right"/>
                                <TextBlock Text="ÄTA kostnad (kr)"/><TextBlock Text="{Binding Outcome.Cost, StringFormat=N0}" TextAlignment="Right"/>
                                <TextBlock Text="ÄTA resultat (kr)"/><TextBlock Text="{Binding Outcome.Profit, StringFormat=N0}" TextAlignment="Right"/>
                                <TextBlock Text="ÄTA marginal (%)"/><TextBlock Text="{Binding Outcome.Margin, StringFormat=N1}" TextAlignment="Right"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <views:LubeSummaryReportView DataContext="{Binding Summary}" Loaded="LubeSummaryReportView_Loaded"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Sakvaror (Bild 3 och Bild 4) -->
            <TabItem Header="{DynamicResource SubTabSakvarorSpec}" Visibility="{Binding SakvarorSpecTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <views:SakvaraActionsBar Grid.Row="0" Grid.ColumnSpan="3"
                        SelectedArticles="{Binding SelectedItems, ElementName=SakvarorSpecificationGrid, Mode=OneWay}"
                        TargetGrid="{Binding ElementName=SakvarorSpecificationGrid, Mode=OneWay}"/>
                    <DataGrid x:Name="SakvarorSpecificationGrid" Grid.Row="1" Grid.ColumnSpan="3"
                        Style="{StaticResource SakvaraReportGrid}"
                        ItemsSource="{Binding SpecificationRows}"
                        AutoGenerateColumns="False"
                        IsReadOnly="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        RowStyle="{StaticResource SakvaraRowStyle}"
                        RowEditEnding="SakvarorGrid_RowEditEnding"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow"
                        Loaded="SakvarorGrid_Loaded"
                        DataContextChanged="SakvarorGrid_DataContextChanged"
                        BeginningEdit="SakvarorGrid_BeginningEdit"
                        SelectionChanged="SakvarorGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Grupp" Binding="{Binding Grupp}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Beteckning-D1-D2" Binding="{Binding Beteckning}" Width="150" FontWeight="SemiBold" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Antal" Binding="{Binding Antal, StringFormat={}{0:N0}}" Width="65" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="Produkt" Binding="{Binding Produkt}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Produktkod" Width="110" IsReadOnly="False" ElementStyle="{StaticResource RightAlignCell}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Produktkod" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ConverterCulture="sv-SE" ValidatesOnExceptions="True" StringFormat="N2"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Leverantör" Width="140" IsReadOnly="False" ElementStyle="{StaticResource RightAlignCell}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Leverantor" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ConverterCulture="sv-SE" ValidatesOnExceptions="True" StringFormat="N2"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Pris bto" Binding="{Binding PrisBto, StringFormat={}{0:N0}}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="%" Binding="{Binding RabattSats, StringFormat={}{0:N0}}" Width="50" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="Pris nto" Width="100" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="PrisNto" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ConverterCulture="sv-SE" ValidatesOnExceptions="True" StringFormat="N2"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <views:SakvaraPriceColumn Header="Offertpris" IsFinalPrice="False" Width="110" ElementStyle="{StaticResource CompactLubeQuotedPriceText}" EditingElementStyle="{StaticResource NumericCellEdit}">
                                <views:SakvaraPriceColumn.Binding>
                                    <Binding Path="Offertpris" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ConverterCulture="sv-SE" ValidatesOnExceptions="True" StringFormat="N2"/>
                                </views:SakvaraPriceColumn.Binding>
                            </views:SakvaraPriceColumn>
                            <views:SakvaraPriceColumn Header="Slutpris" IsFinalPrice="True" Width="110" ElementStyle="{StaticResource CompactLubeFinalPriceText}" EditingElementStyle="{StaticResource NumericCellEdit}">
                                <views:SakvaraPriceColumn.Binding>
                                    <Binding Path="Slutpris" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ConverterCulture="sv-SE" ValidatesOnExceptions="True" StringFormat="N2"/>
                                </views:SakvaraPriceColumn.Binding>
                            </views:SakvaraPriceColumn>
                            <DataGridTextColumn Header="Differens" Binding="{Binding Differens, StringFormat={}{0:N0}}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTemplateColumn Header="Köpt" Width="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding ArKopt, Mode=OneWay}"
                                                Command="{Binding DataContext.MarkeraKoptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsThreeState="False"
                                                AutomationProperties.Name="Köpt"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Anteckningar" Binding="{Binding Anteckningar, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="260" IsReadOnly="False"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <views:SakvarorTotalsFooter Grid.Row="2"
    TargetGrid="{Binding ElementName=SakvarorSpecificationGrid}"
    PrisNto="{Binding SumPrisNto}"
    Offertpris="{Binding SumOffertpris}"
    Slutpris="{Binding SumSlutpris}"
    Differens="{Binding SumDifferens}"
    FontFamily="Arial" FontSize="11" FontWeight="Bold" Height="22"/>
                </Grid>
            </TabItem>

            <!-- 3. Kalkylblad / Rådata -->
            <TabItem Header="{DynamicResource SubTabKalkyl}" Visibility="{Binding KalkylTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid ItemsSource="{Binding FilteredKalkylPoster}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="100"/>
                        <DataGridTextColumn Header="Benämning" Binding="{Binding Benamning}" Width="*"/>
                        <DataGridTextColumn Header="Enhet" Binding="{Binding Enhet}" Width="70"/>
                        <DataGridTextColumn Header="Montage h/enhet" Binding="{Binding MontageTimmar, StringFormat=N2}" Width="120"/>
                        <DataGridTextColumn Header="Timmar totalt" Binding="{Binding TotaltMontageTimmar, StringFormat=N2}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabAnpassning}" Visibility="{Binding AnpassningTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid ItemsSource="{Binding Projektanpassningar}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="*"/>
                        <DataGridTextColumn Header="Beskrivning" Binding="{Binding Beskrivning}" Width="*"/>
                        <DataGridTextColumn Header="Värde" Binding="{Binding Varde}" Width="150"/>
                        <DataGridTextColumn Header="Enhet" Binding="{Binding Enhet}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorMangd}" Visibility="{Binding SakvarorMangdTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid Style="{StaticResource SakvaraReportGrid}" Margin="12" ItemsSource="{Binding SakvarorMangder}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Beteckning" Binding="{Binding Beteckning}" Width="*"/>
                        <DataGridTextColumn Header="Dim 1" Binding="{Binding Dim1}" Width="130"/>
                        <DataGridTextColumn Header="Dim 2" Binding="{Binding Dim2}" Width="130"/>
                        <DataGridTextColumn Header="Antal" Binding="{Binding Antal}" Width="100"/>
                        <DataGridTextColumn Header="Enhet" Binding="{Binding Enhet}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorOffert}" Visibility="{Binding SakvarorOffertTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid Style="{StaticResource SakvaraReportGrid}" Margin="12" ItemsSource="{Binding SakvarorOfferter}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Leverantör" Binding="{Binding Leverantor}" Width="*"/>
                        <DataGridTextColumn Header="Produktgrupp" Binding="{Binding Produktgrupp}" Width="*"/>
                        <DataGridTextColumn Header="Offertpris" Binding="{Binding OffereratPris, StringFormat=N2}" Width="130"/>
                        <DataGridTextColumn Header="Valuta" Binding="{Binding Valuta}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorLeverans}" Visibility="{Binding LeveransTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid Margin="12">
                    <DataGrid Style="{StaticResource SakvaraReportGrid}" Margin="0" ItemsSource="{Binding SakvarorLeveranser}" AutoGenerateColumns="False" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Grupp" Binding="{Binding Grupp}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Beteckning-D1-D2" Binding="{Binding Beteckning}" Width="150" FontWeight="SemiBold" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Antal" Binding="{Binding Antal, StringFormat={}{0:N0}}" Width="65" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="Produkt" Binding="{Binding Produkt}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Produktkod" Width="110" IsReadOnly="False" ElementStyle="{StaticResource RightAlignCell}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Produktkod" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ConverterCulture="sv-SE" ValidatesOnExceptions="True" StringFormat="N2"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Leverantör" Width="140" IsReadOnly="False" ElementStyle="{StaticResource RightAlignCell}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Leverantor" Mode="TwoWay" UpdateSourceTrigger="LostFocus" ConverterCulture="sv-SE" ValidatesOnExceptions="True" StringFormat="N2"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Pris bto" Binding="{Binding PrisBto, StringFormat={}{0:N0}}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="%" Binding="{Binding RabattSats, StringFormat={}{0:N0}}" Width="50" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="Pris nto" Width="100" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="PrisNto" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ConverterCulture="sv-SE" ValidatesOnExceptions="True" StringFormat="N2"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <views:SakvaraPriceColumn Header="Offertpris" IsFinalPrice="False" Width="110" ElementStyle="{StaticResource CompactLubeQuotedPriceText}" EditingElementStyle="{StaticResource NumericCellEdit}">
                                <views:SakvaraPriceColumn.Binding>
                                    <Binding Path="Offertpris" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ConverterCulture="sv-SE" ValidatesOnExceptions="True" StringFormat="N2"/>
                                </views:SakvaraPriceColumn.Binding>
                            </views:SakvaraPriceColumn>
                            <views:SakvaraPriceColumn Header="Slutpris" IsFinalPrice="True" Width="110" ElementStyle="{StaticResource CompactLubeFinalPriceText}" EditingElementStyle="{StaticResource NumericCellEdit}">
                                <views:SakvaraPriceColumn.Binding>
                                    <Binding Path="Slutpris" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ConverterCulture="sv-SE" ValidatesOnExceptions="True" StringFormat="N2"/>
                                </views:SakvaraPriceColumn.Binding>
                            </views:SakvaraPriceColumn>
                            <DataGridTextColumn Header="Differens" Binding="{Binding Differens, StringFormat={}{0:N0}}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTemplateColumn Header="Köpt" Width="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ArKopt, Converter={StaticResource KoptButtonText}}"
                                                Command="{Binding DataContext.MarkeraKoptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3"
                                                Cursor="Hand"
                                                HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorMontage}" Visibility="{Binding MontageTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid Style="{StaticResource SakvaraReportGrid}" Margin="12" ItemsSource="{Binding SakvarorMontage}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kategori" Binding="{Binding ProduktKategori}" Width="*"/>
                        <DataGridTextColumn Header="Beteckning" Binding="{Binding Beteckning}" Width="*"/>
                        <DataGridTextColumn Header="Montage h/st" Binding="{Binding MontageTimmarPerEnhet}" Width="120"/>
                        <DataGridTextColumn Header="Injustering h/st" Binding="{Binding InjusteringTimmarPerEnhet}" Width="130"/>
                        <DataGridTextColumn Header="Antal" Binding="{Binding Antal}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabEjMangd}" Visibility="{Binding EjMangdTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid ItemsSource="{Binding EjMangdbaserade}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Moment" Binding="{Binding Moment}" Width="*"/>
                        <DataGridTextColumn Header="Timmar" Binding="{Binding Timmar}" Width="120"/>
                        <DataGridTextColumn Header="Kostnad" Binding="{Binding Kostnad, StringFormat=N2}" Width="130"/>
                        <DataGridTextColumn Header="Kommentar" Binding="{Binding Kommentar}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <ToggleButton x:Name="TabPickerButton"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,4,2,0"
                      Padding="10,6"
                      Cursor="Hand"
                      Background="Transparent"
                      BorderThickness="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="☰" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource ChooseTabs}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>
        <Popup PlacementTarget="{Binding ElementName=TabPickerButton}"
               Placement="Bottom"
               StaysOpen="False"
               IsOpen="{Binding IsChecked, ElementName=TabPickerButton, Mode=TwoWay}"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Width="280">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource ChooseTabsTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding TabOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Title}"
                                          IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanHide}"
                                          Margin="0,5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
        </Grid>
    </Grid>
</UserControl>