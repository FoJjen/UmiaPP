<UserControl x:Class="UmiaPP.Views.LubeCalculationTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:UmiaPP.Converters" xmlns:views="clr-namespace:UmiaPP.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DifferensRowBrushConverter x:Key="DifferensRowBrush"/>
        <converters:KoptButtonTextConverter x:Key="KoptButtonText"/>
        <Style x:Key="RightAlignCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="RightAlignEdit" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="SakvaraReportRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="#99CCFF"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="MinHeight" Value="19"/>
        </Style>
        <Style x:Key="SakvaraRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SakvaraReportRow}">
            <Setter Property="Background" Value="{Binding Differens, Converter={StaticResource DifferensRowBrush}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Differens}" Value="0">
                    <Setter Property="Background" Value="#99CCFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SakvaraReportHeader" TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SakvaraReportCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="#124E78"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="Black"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SakvaraReportGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Black"/>
            <Setter Property="VerticalGridLinesBrush" Value="Black"/>
            <Setter Property="RowBackground" Value="#99CCFF"/>
            <Setter Property="AlternatingRowBackground" Value="#99CCFF"/>
            <Setter Property="RowHeight" Value="NaN"/>
            <Setter Property="MinRowHeight" Value="19"/>
            <Setter Property="ColumnHeaderHeight" Value="NaN"/>
            <Setter Property="RowStyle" Value="{StaticResource SakvaraReportRow}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource SakvaraReportHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource SakvaraReportCell}"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><Button Content="{DynamicResource ImportLubeBtn}" Command="{Binding ImportLubeExcelCommand}" Style="{StaticResource AccentButton}" DockPanel.Dock="Left"/><TextBox Width="250" HorizontalAlignment="Right" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource FilterPlaceholder}"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,16,0,0">
        <TabControl SelectedIndex="{Binding SelectedLubeTabIndex}">
            <!-- 1. Kalkylsammandrag (Exakt som Bild 2) -->
            <TabItem Header="{DynamicResource SubTabSammandrag}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel>
                    <views:LubeSummaryReportView DataContext="{Binding Summary}">
                        <views:LubeSummaryReportView.Style>
                            <Style TargetType="views:LubeSummaryReportView">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportSections.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:LubeSummaryReportView.Style>
                    </views:LubeSummaryReportView>
                    <StackPanel Margin="0,15,0,25" MaxWidth="1050" HorizontalAlignment="Left">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Summary.ReportSections.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- MONTAGE -->
                        <Border BorderBrush="#124E78" BorderThickness="0,0,0,2" Margin="0,0,0,8" Padding="0,0,0,4">
                            <TextBlock Text="MONTAGE" FontWeight="Bold" FontSize="15" Foreground="#124E78"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding Summary.MontageGrupper}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PRODUKTGRUPP" Binding="{Binding Produktgrupp}" Width="260" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="LISTA" Binding="{Binding Lista}" Width="220"/>
                                <DataGridTextColumn Header="TIM." Binding="{Binding Timmar, StringFormat={}{0:N0}}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="480"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="SUMMA FÖRE JUSTERING" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Summary.SummaForeJusteringTimmar, StringFormat={}{0:N0}}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="480"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Projektanpassning"/>
                            <TextBlock Grid.Column="1" Text="{Binding Summary.ProjektanpassningTimmar, StringFormat={}{0:N0}}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Del summeringar montage -->
                        <Border Background="#EBF4FA" BorderBrush="#B8D5E5" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="340"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Kr/del" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Kr. Nto" FontWeight="Bold" HorizontalAlignment="Right"/>

                                <!-- Summa efter justering -->
                                <TextBlock Grid.Row="1" Text="SUMMA EFTER JUSTERING" FontWeight="Bold" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.SummaEfterJusteringTimmar, StringFormat={}{0:N0} tim.}" HorizontalAlignment="Right" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Summary.MontageTimlon, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Summary.SummaEfterJusteringKrNto, StringFormat={}{0:N0}}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,3"/>

                                <!-- Restidsersättning -->
                                <TextBlock Grid.Row="2" Text="Restidsersättning" Margin="0,3,0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.RestidTimmar, StringFormat={}{0:N0} tim.}" HorizontalAlignment="Right" Margin="0,3,0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Summary.RestidTimlon, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,3,0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Summary.RestidKrNto, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,3,0,3"/>

                                <!-- Reskostnad -->
                                <TextBlock Grid.Row="3" Text="Reskostnad" Margin="0,3,0,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.ReskostnadKm, StringFormat={}{0:N0} km}" HorizontalAlignment="Right" Margin="0,3,0,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Summary.ReskostnadKrPerKm, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,3,0,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Summary.ReskostnadKrNto, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,3,0,3"/>

                                <!-- Summa montage -->
                                <TextBlock Grid.Row="4" Text="SUMMA MONTAGE" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Summary.SummaMontageTotal, StringFormat={}{0:N0}}" FontWeight="Bold" FontSize="14" Foreground="#124E78" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <!-- INJUSTERING MED MERA -->
                        <Border BorderBrush="#124E78" BorderThickness="0,0,0,2" Margin="0,0,0,8" Padding="0,0,0,4">
                            <TextBlock Text="INJUSTERING MED MERA" FontWeight="Bold" FontSize="15" Foreground="#124E78"/>
                        </Border>
                        <Border Background="#EBF4FA" BorderBrush="#B8D5E5" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="PRODUKTGRUPP" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="LISTA" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="TIM." FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="TIMLÖN" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="Kr. Nto" FontWeight="Bold" HorizontalAlignment="Right"/>

                                <TextBlock Grid.Row="1" Text="Injustering" Margin="0,6,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.InjusteringLista}" Margin="0,6,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Summary.InjusteringTimmar, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,6,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Summary.InjusteringTimlon, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,6,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Summary.InjusteringKrNto, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,6,0,4"/>

                                <TextBlock Grid.Row="2" Text="SUMMA INJUSTERING" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding Summary.SummaInjusteringTotal, StringFormat={}{0:N0}}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>

                        <!-- LEVERANSER -->
                        <Border BorderBrush="#124E78" BorderThickness="0,0,0,2" Margin="0,0,0,8" Padding="0,0,0,4">
                            <TextBlock Text="LEVERANSER" FontWeight="Bold" FontSize="15" Foreground="#124E78"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding Summary.LeveransGrupper}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="All">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PRODUKTGRUPP" Binding="{Binding Produktgrupp}" Width="260" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="PRISLISTA" Binding="{Binding Lista}" Width="220"/>
                                <DataGridTextColumn Header="Kr. Bto" Binding="{Binding PrisBto, StringFormat={}{0:N0}}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="%" Binding="{Binding RabattSats, StringFormat={}{0:N0}}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Kr. Nto" Binding="{Binding PrisNto, StringFormat={}{0:N0}}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#EBF4FA" BorderBrush="#B8D5E5" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="480"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="SUMMA FÖRE JUSTERING" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="{Binding Summary.LeveransSummaForeJustering, StringFormat={}{0:N0}}" FontWeight="Bold" HorizontalAlignment="Right"/>

                                <TextBlock Grid.Row="1" Text="Frakter" Margin="0,5,0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.FrakterPct, StringFormat={}{0:N0} %}" HorizontalAlignment="Right" Margin="0,5,0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Summary.FrakterKr, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,5,0,2"/>

                                <TextBlock Grid.Row="2" Text="Montagematerial" Margin="0,2,0,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.MontagematerialPct, StringFormat={}{0:N0} %}" HorizontalAlignment="Right" Margin="0,2,0,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Summary.MontagematerialKr, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,2,0,5"/>

                                <TextBlock Grid.Row="3" Text="SUMMA LEVERANS" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Summary.SummaLeveransTotal, StringFormat={}{0:N0}}" FontWeight="Bold" FontSize="14" Foreground="#124E78" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>

                        <!-- TOTAL PRODUKTIONSKOSTNAD -->
                        <Border BorderBrush="#124E78" BorderThickness="0,0,0,2" Margin="0,0,0,8" Padding="0,0,0,4">
                            <TextBlock Text="TOTAL PRODUKTIONSKOSTNAD" FontWeight="Bold" FontSize="15" Foreground="#124E78"/>
                        </Border>
                        <Border Background="#FFFFFF" BorderBrush="#124E78" BorderThickness="2" CornerRadius="6" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="480"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Övrigt" Margin="0,3,0,3"/>
                                <TextBlock Grid.Column="2" Text="{Binding Summary.OvrigtKr, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="1" Text="Montage och injustering med mera" Margin="0,3,0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Summary.MontageOchInjusteringKr, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="2" Text="Leverans" Margin="0,3,0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Summary.SummaLeveransTotal, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="3" Text="Underentreprenader" Margin="0,3,0,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Summary.SummaUnderentreprenad, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Margin="0,3,0,3"/>

                                <Border Grid.Row="4" Grid.ColumnSpan="3" BorderBrush="#124E78" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                    <Grid>
                                        <TextBlock Text="TOTAL PRODUKTIONSKOSTNAD" FontWeight="Bold" FontSize="16" Foreground="#124E78"/>
                                        <TextBlock Text="{Binding Summary.TotalProduktionskostnad, StringFormat={}{0:N0} kr}" FontWeight="Bold" FontSize="18" Foreground="#F26419" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Sakvaror (Exakt som Bild 1 Lubekalk rapport) -->
            <TabItem Header="{DynamicResource SubTabSakvarorSpec}" Visibility="{Binding SakvarorSpecTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid Margin="12" TextElement.FontFamily="Arial" TextElement.FontSize="11">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Style="{StaticResource SakvaraReportGrid}" ItemsSource="{Binding FilteredSakvaror}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" HeadersVisibility="Column" RowStyle="{StaticResource SakvaraRowStyle}" RowEditEnding="SakvarorGrid_RowEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Grupp" Binding="{Binding Grupp}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Beteckning-D1-D2" Binding="{Binding Beteckning}" Width="150" FontWeight="SemiBold" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Antal" Binding="{Binding Antal, StringFormat={}{0:N0}}" Width="65" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="Produkt" Binding="{Binding Produkt}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Produktkod" Binding="{Binding Produktkod}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Leverantör" Binding="{Binding Leverantor}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Pris bto" Binding="{Binding PrisBto, StringFormat={}{0:N0}}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="%" Binding="{Binding RabattSats, StringFormat={}{0:N0}}" Width="50" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="Pris nto" Binding="{Binding PrisNto, StringFormat={}{0:N0}}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="Offertpris" Binding="{Binding Offertpris, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" Width="110" ElementStyle="{StaticResource RightAlignCell}" EditingElementStyle="{StaticResource RightAlignEdit}"/>
                            <DataGridTextColumn Header="Slutpris" Binding="{Binding Slutpris, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" Width="110" ElementStyle="{StaticResource RightAlignCell}" EditingElementStyle="{StaticResource RightAlignEdit}"/>
                            <DataGridTextColumn Header="Differens" Binding="{Binding Differens, StringFormat={}{0:N0}}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTemplateColumn Header="Köpt" Width="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding ArKopt, Mode=OneWay}"
                                                Command="{Binding DataContext.MarkeraKoptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsThreeState="False"
                                                AutomationProperties.Name="Köpt"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Anteckningar" Binding="{Binding Anteckningar, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="260" IsReadOnly="False"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Padding="6,2" BorderBrush="Black" BorderThickness="1,0,1,1" Background="White" MinHeight="19">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Summa Slutpris (alla rader):" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding SumSlutpris, StringFormat={}{0:N2} kr}" FontWeight="Bold" Foreground="Black"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 3. Kalkylblad / Rådata -->
            <TabItem Header="{DynamicResource SubTabKalkyl}" Visibility="{Binding KalkylTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid ItemsSource="{Binding FilteredKalkylPoster}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="100"/>
                        <DataGridTextColumn Header="Benämning" Binding="{Binding Benamning}" Width="*"/>
                        <DataGridTextColumn Header="Enhet" Binding="{Binding Enhet}" Width="70"/>
                        <DataGridTextColumn Header="Mängd" Binding="{Binding Mangd, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Material/enhet" Binding="{Binding MaterialKostnad, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Montage h/enhet" Binding="{Binding MontageTimmar, StringFormat=N2}" Width="120"/>
                        <DataGridTextColumn Header="Material totalt" Binding="{Binding TotaltMaterial, StringFormat=N2}" Width="120"/>
                        <DataGridTextColumn Header="Timmar totalt" Binding="{Binding TotaltMontageTimmar, StringFormat=N2}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabAnpassning}" Visibility="{Binding AnpassningTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid ItemsSource="{Binding Projektanpassningar}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="*"/>
                        <DataGridTextColumn Header="Beskrivning" Binding="{Binding Beskrivning}" Width="*"/>
                        <DataGridTextColumn Header="Värde" Binding="{Binding Varde}" Width="150"/>
                        <DataGridTextColumn Header="Enhet" Binding="{Binding Enhet}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorMangd}" Visibility="{Binding SakvarorMangdTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid Style="{StaticResource SakvaraReportGrid}" Margin="12" ItemsSource="{Binding SakvarorMangder}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Beteckning" Binding="{Binding Beteckning}" Width="*"/>
                        <DataGridTextColumn Header="Dim 1" Binding="{Binding Dim1}" Width="130"/>
                        <DataGridTextColumn Header="Dim 2" Binding="{Binding Dim2}" Width="130"/>
                        <DataGridTextColumn Header="Antal" Binding="{Binding Antal}" Width="100"/>
                        <DataGridTextColumn Header="Enhet" Binding="{Binding Enhet}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorOffert}" Visibility="{Binding SakvarorOffertTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid Style="{StaticResource SakvaraReportGrid}" Margin="12" ItemsSource="{Binding SakvarorOfferter}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Leverantör" Binding="{Binding Leverantor}" Width="*"/>
                        <DataGridTextColumn Header="Produktgrupp" Binding="{Binding Produktgrupp}" Width="*"/>
                        <DataGridTextColumn Header="Offertpris" Binding="{Binding OffereratPris, StringFormat=N2}" Width="130"/>
                        <DataGridTextColumn Header="Valuta" Binding="{Binding Valuta}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorLeverans}" Visibility="{Binding LeveransTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid Margin="12">
                    <DataGrid Style="{StaticResource SakvaraReportGrid}" ItemsSource="{Binding FilteredSakvaror}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" HeadersVisibility="Column" RowStyle="{StaticResource SakvaraRowStyle}" RowEditEnding="SakvarorGrid_RowEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Grupp" Binding="{Binding Grupp}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Beteckning-D1-D2" Binding="{Binding Beteckning}" Width="150" FontWeight="SemiBold" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Antal" Binding="{Binding Antal, StringFormat={}{0:N0}}" Width="65" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="Produkt" Binding="{Binding Produkt}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Produktkod" Binding="{Binding Produktkod}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Leverantör" Binding="{Binding Leverantor}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Pris bto" Binding="{Binding PrisBto, StringFormat={}{0:N0}}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="%" Binding="{Binding RabattSats, StringFormat={}{0:N0}}" Width="50" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="Pris nto" Binding="{Binding PrisNto, StringFormat={}{0:N0}}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTextColumn Header="Offertpris" Binding="{Binding Offertpris, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" Width="110" ElementStyle="{StaticResource RightAlignCell}" EditingElementStyle="{StaticResource RightAlignEdit}"/>
                            <DataGridTextColumn Header="Slutpris" Binding="{Binding Slutpris, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" Width="110" ElementStyle="{StaticResource RightAlignCell}" EditingElementStyle="{StaticResource RightAlignEdit}"/>
                            <DataGridTextColumn Header="Differens" Binding="{Binding Differens, StringFormat={}{0:N0}}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource RightAlignCell}"/>
                            <DataGridTemplateColumn Header="Köpt" Width="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ArKopt, Converter={StaticResource KoptButtonText}}"
                                                Command="{Binding DataContext.MarkeraKoptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3"
                                                Cursor="Hand"
                                                HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorMontage}" Visibility="{Binding MontageTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid Style="{StaticResource SakvaraReportGrid}" Margin="12" ItemsSource="{Binding SakvarorMontage}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kategori" Binding="{Binding ProduktKategori}" Width="*"/>
                        <DataGridTextColumn Header="Beteckning" Binding="{Binding Beteckning}" Width="*"/>
                        <DataGridTextColumn Header="Montage h/st" Binding="{Binding MontageTimmarPerEnhet}" Width="120"/>
                        <DataGridTextColumn Header="Injustering h/st" Binding="{Binding InjusteringTimmarPerEnhet}" Width="130"/>
                        <DataGridTextColumn Header="Antal" Binding="{Binding Antal}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource SubTabEjMangd}" Visibility="{Binding EjMangdTab.IsVisible, Converter={StaticResource BoolToVis}}">
                <DataGrid ItemsSource="{Binding EjMangdbaserade}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Moment" Binding="{Binding Moment}" Width="*"/>
                        <DataGridTextColumn Header="Timmar" Binding="{Binding Timmar}" Width="120"/>
                        <DataGridTextColumn Header="Kostnad" Binding="{Binding Kostnad, StringFormat=N2}" Width="130"/>
                        <DataGridTextColumn Header="Kommentar" Binding="{Binding Kommentar}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <ToggleButton x:Name="TabPickerButton"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,4,2,0"
                      Padding="10,6"
                      Cursor="Hand"
                      IsChecked="{Binding IsTabPickerOpen}"
                      ToolTip="{DynamicResource ChooseTabsTooltip}"
                      Background="Transparent"
                      BorderThickness="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="☰" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource ChooseTabs}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </ToggleButton>
        <Popup IsOpen="{Binding IsTabPickerOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=TabPickerButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Width="280">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource ChooseTabsTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding TabOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Title}"
                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          IsEnabled="{Binding CanHide}"
                                          Margin="0,5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
        </Grid>
    </Grid>
</UserControl>