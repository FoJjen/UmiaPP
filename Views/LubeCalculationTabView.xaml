<UserControl x:Class="UmiaPP.Views.LubeCalculationTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><Button Content="{DynamicResource ImportLubeBtn}" Command="{Binding ImportLubeExcelCommand}" Style="{StaticResource AccentButton}" DockPanel.Dock="Left"/><TextBox Width="250" HorizontalAlignment="Right" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource FilterPlaceholder}"/></DockPanel>
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="15" Margin="0,16,0,16"><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource SumHours}" FontWeight="SemiBold"/><TextBlock Text="{Binding SumTotalTimmar, StringFormat={}{0:N1} h}" Margin="8,0,32,0"/><TextBlock Text="{DynamicResource SumMaterial}" FontWeight="SemiBold"/><TextBlock Text="{Binding SumTotalMaterial, StringFormat={}{0:N0} kr}" Margin="8,0,0,0"/></StackPanel></Border>
        <TabControl Grid.Row="2">
            <TabItem Header="{DynamicResource SubTabKalkyl}"><DataGrid ItemsSource="{Binding FilteredKalkylPoster}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="100"/><DataGridTextColumn Header="Benämning" Binding="{Binding Benamning}" Width="*"/><DataGridTextColumn Header="Enhet" Binding="{Binding Enhet}" Width="70"/><DataGridTextColumn Header="Mängd" Binding="{Binding Mangd, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="Material/enhet" Binding="{Binding MaterialKostnad, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Montage h/enhet" Binding="{Binding MontageTimmar, StringFormat=N2}" Width="120"/><DataGridTextColumn Header="Material totalt" Binding="{Binding TotaltMaterial, StringFormat=N2}" Width="120"/><DataGridTextColumn Header="Timmar totalt" Binding="{Binding TotaltMontageTimmar, StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="{DynamicResource SubTabAnpassning}"><DataGrid ItemsSource="{Binding Projektanpassningar}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="*"/><DataGridTextColumn Header="Beskrivning" Binding="{Binding Beskrivning}" Width="*"/><DataGridTextColumn Header="Värde" Binding="{Binding Varde}" Width="150"/><DataGridTextColumn Header="Enhet" Binding="{Binding Enhet}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorMangd}"><DataGrid ItemsSource="{Binding SakvarorMangder}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Beteckning" Binding="{Binding Beteckning}" Width="*"/><DataGridTextColumn Header="Dim 1" Binding="{Binding Dim1}" Width="130"/><DataGridTextColumn Header="Dim 2" Binding="{Binding Dim2}" Width="130"/><DataGridTextColumn Header="Antal" Binding="{Binding Antal}" Width="100"/><DataGridTextColumn Header="Enhet" Binding="{Binding Enhet}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorOffert}"><DataGrid ItemsSource="{Binding SakvarorOfferter}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Leverantör" Binding="{Binding Leverantor}" Width="*"/><DataGridTextColumn Header="Produktgrupp" Binding="{Binding Produktgrupp}" Width="*"/><DataGridTextColumn Header="Offertpris" Binding="{Binding OffereratPris, StringFormat=N2}" Width="130"/><DataGridTextColumn Header="Valuta" Binding="{Binding Valuta}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorLeverans}"><DataGrid ItemsSource="{Binding SakvarorLeveranspriser}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Produkt" Binding="{Binding Produkt}" Width="*"/><DataGridTextColumn Header="Leverantör" Binding="{Binding Leverantor}" Width="*"/><DataGridTextColumn Header="Bruttopris" Binding="{Binding BruttoPris, StringFormat=N2}" Width="130"/><DataGridTextColumn Header="Rabatt %" Binding="{Binding RabattSats, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Netto" Binding="{Binding NettoPris, StringFormat=N2}" Width="130"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="{DynamicResource SubTabSakvarorMontage}"><DataGrid ItemsSource="{Binding SakvarorMontage}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Kategori" Binding="{Binding ProduktKategori}" Width="*"/><DataGridTextColumn Header="Beteckning" Binding="{Binding Beteckning}" Width="*"/><DataGridTextColumn Header="Montage h/st" Binding="{Binding MontageTimmarPerEnhet}" Width="120"/><DataGridTextColumn Header="Injustering h/st" Binding="{Binding InjusteringTimmarPerEnhet}" Width="130"/><DataGridTextColumn Header="Antal" Binding="{Binding Antal}" Width="90"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="{DynamicResource SubTabEjMangd}"><DataGrid ItemsSource="{Binding EjMangdbaserade}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Moment" Binding="{Binding Moment}" Width="*"/><DataGridTextColumn Header="Timmar" Binding="{Binding Timmar}" Width="120"/><DataGridTextColumn Header="Kostnad" Binding="{Binding Kostnad, StringFormat=N2}" Width="130"/><DataGridTextColumn Header="Kommentar" Binding="{Binding Kommentar}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
        </TabControl>
    </Grid>
</UserControl>