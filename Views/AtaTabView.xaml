<UserControl x:Class="UmiaPP.Views.AtaTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,28,0,0"><Border Style="{StaticResource ModernCard}" HorizontalAlignment="Center" VerticalAlignment="Top" Width="650"><StackPanel><TextBlock Text="{DynamicResource AtaHeading}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource AtaDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,22"/><Button Content="{DynamicResource RegisterAta}" Command="{Binding RegisterAtaCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border></Grid>
</UserControl>