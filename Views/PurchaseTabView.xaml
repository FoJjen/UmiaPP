<UserControl x:Class="UmiaPP.Views.PurchaseTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Language="sv-SE">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="0,18,0,0">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsListsBusy}" Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,10">
            <Button Content="Importera Bluebeam XML" Command="{Binding ImportDrawingListsCommand}" Style="{StaticResource AccentButton}" Margin="0,0,12,0"/>
            <TextBox Width="230" Text="{Binding NewListName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Namn eller ritningsnummer för egen komponentlista" Margin="0,0,8,0" TextChanged="TextBox_TextChanged"/>
            <Button Content="Skapa egen komponentlista" Command="{Binding CreateManualListCommand}" Style="{StaticResource SecondaryButton}"/>
        </WrapPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Markera alla listor" Click="SelectAllLists_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="12,0,0,0"/>
            <StackPanel>
                <TextBlock Text="Projektets ritningar och komponentlistor" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ListStatus}" TextWrapping="Wrap"/>
                <TextBlock Text="Välj flera listor med Ctrl-klick, Shift-klick eller Markera alla listor för att summera artiklar." TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="DrawingsGrid" Grid.Row="2" ItemsSource="{Binding Drawings}" SelectedItem="{Binding SelectedDrawing, Mode=OneWay}" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="Drawings_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="32" FontSize="13" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}" VerticalGridLinesBrush="Transparent">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,4"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ritning / Lista" Binding="{Binding DrawingNumber}" Width="2*"/>
                <DataGridTextColumn Header="Titel" Binding="{Binding SheetTitle}" Width="2*"/>
                <DataGridTextColumn Header="Revision" Binding="{Binding Revision}" Width="80"/>
                <DataGridTemplateColumn Header="Importkälla" Width="160">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding PurchaseImportSource, Converter={StaticResource FileNameDisplayConverter}}" ToolTip="{Binding PurchaseImportSource}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Datum" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridTemplateColumn Header="Kopplad PDF" Width="*">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding FilePath, Converter={StaticResource FileNameDisplayConverter}}" ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Åtgärder" Width="128">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Ta bort lista"
                                    Command="{Binding DataContext.DeleteDrawingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="10,4" Margin="0" FontSize="12" MinHeight="0" Height="26" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="3" Margin="0,10,0,10">
            <Button Content="Koppla PDF" Command="{Binding LinkListPdfCommand}" IsEnabled="{Binding CanEditSelectedList}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="Öppna PDF" Command="{Binding OpenDrawingFileCommand}" CommandParameter="{Binding SelectedDrawing}" IsEnabled="{Binding CanEditSelectedList}" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0"/>
   <Button Content="Ny artikel" Command="{Binding AddPurchaseArticleCommand}" IsEnabled="{Binding CanEditSelectedList}" Style="{StaticResource AccentButton}" Margin="0,0,16,0"/>
   <Button Content="Exportera visad lista" Command="{Binding ExportSelectedListCommand}" IsEnabled="{Binding CanEditSelectedList}" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0"/>
   <Button Content="Exportera alla listor" Command="{Binding ExportAllListsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0" ToolTip="Exporterar alla projektets listor: sammanfattning först, sedan ett blad per ritning eller lista."/>
            <TextBlock Text="Kategori" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="160" ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}" Margin="0,0,12,0"/>
            <TextBlock Text="Typ" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="190" ItemsSource="{Binding ArticleTypes}" SelectedItem="{Binding TypeFilter}"/>
        </WrapPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ArticlesGrid" ItemsSource="{Binding ArticleView}" SelectedItem="{Binding SelectedArticle}" RowEditEnding="Articles_RowEditEnding" BeginningEdit="Articles_BeginningEdit" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="120" SelectionChanged="DataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Category, Mode=TwoWay}" Width="Auto"/>
                    <DataGridTextColumn Header="Typ / Artikel" Binding="{Binding Type, Mode=TwoWay}" Width="Auto"/>
                    <DataGridTextColumn Header="Dimension / Beteckning" Binding="{Binding Dimension, Mode=TwoWay}" Width="Auto"/>
                    <DataGridTextColumn Header="Mängd" Width="Auto" ElementStyle="{StaticResource NumericCellText}" EditingElementStyle="{StaticResource NumericCellEdit}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="Quantity" Mode="TwoWay" ConverterCulture="sv-SE" StringFormat="N2" ValidatesOnExceptions="True"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Enhet" Binding="{Binding Unit, Mode=TwoWay}" Width="Auto"/>
                    <DataGridTextColumn Header="Inköpsantal" Binding="{Binding PurchaseQuantity, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="Auto" ElementStyle="{StaticResource NumericCellText}" EditingElementStyle="{StaticResource NumericCellEdit}"/>
                    <DataGridTextColumn Header="Inköpsenhet" Binding="{Binding PurchaseUnit, Mode=OneWay}" IsReadOnly="True" Width="Auto"/>
                    <DataGridTextColumn Header="Produktkod" Binding="{Binding ProductCode, Mode=TwoWay}" Width="Auto"/>
                    <DataGridTextColumn Header="Leverantör" Binding="{Binding Supplier, Mode=TwoWay}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
            <Expander Grid.Column="1" Header="PDF" ExpandDirection="Left" IsExpanded="False" Margin="10,0,0,0">
                <Grid Width="480">
                    <TextBlock Text="Koppla en PDF till vald ritning eller lista. Automatisk artikelutläsning från PDF ingår inte ännu." TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"/>
                    <wv2:WebView2 Source="{Binding LoadedPdfUri, Mode=OneWay, TargetNullValue='about:blank', FallbackValue='about:blank'}" Visibility="{Binding HasLoadedPdf, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Expander>
        </Grid>
    </Grid>
</UserControl>