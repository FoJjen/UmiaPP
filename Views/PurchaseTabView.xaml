<UserControl x:Class="UmiaPP.Views.PurchaseTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0">
        <DockPanel Margin="0,0,0,12">
            <Button Content="{DynamicResource LoadPdf}"
                    Command="{Binding LoadPdfCommand}"
                    Style="{StaticResource AccentButton}"
                    DockPanel.Dock="Left"
                    Margin="0,0,12,0"/>
            <TextBlock Text="{Binding LoadedPdfName}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Visibility="{Binding HasLoadedPdf, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>
        <Border Style="{StaticResource ModernCard}" Padding="0" Height="520" Margin="0,0,0,18">
            <Grid>
                <TextBlock Text="{DynamicResource NoPdfLoaded}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <wv2:WebView2 Source="{Binding LoadedPdfUri}"
                              Visibility="{Binding HasLoadedPdf, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
        <TextBlock Text="{DynamicResource SectionDrawings}" FontSize="20" FontWeight="SemiBold"/>
        <Border Style="{StaticResource ModernCard}" Margin="0,12,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/></Grid.RowDefinitions>
            <UniformGrid Columns="4" Margin="0,0,0,10"><StackPanel Margin="0,0,8,0"><TextBlock Text="Ritningsnummer"/><TextBox Text="{Binding NewDrawingNumber}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Titel"/><TextBox Text="{Binding NewSheetTitle}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Revision"/><TextBox Text="{Binding NewRevision}"/></StackPanel><StackPanel><TextBlock Text="PDF-fil"/><DockPanel><Button Content="..." Command="{Binding BrowsePdfCommand}" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Margin="6,0,0,0"/><TextBox Text="{Binding NewFilePath}"/></DockPanel></StackPanel></UniformGrid>
            <Button Grid.Row="1" Content="{DynamicResource AddDrawing}" Command="{Binding AddDrawingCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
            <DataGrid Grid.Row="2" Margin="0,15,0,0" ItemsSource="{Binding Drawings}" SelectedItem="{Binding SelectedDrawing}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Ritningsnummer" Binding="{Binding DrawingNumber}" Width="150"/><DataGridTextColumn Header="Sidetikett/Titel" Binding="{Binding SheetTitle}" Width="*"/><DataGridTextColumn Header="Revision" Binding="{Binding Revision}" Width="100"/><DataGridTextColumn Header="Datum" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/><DataGridTextColumn Header="Filväg" Binding="{Binding FilePath}" Width="*"/><DataGridTemplateColumn Header="Åtgärder" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Öppna" Command="{Binding DataContext.OpenDrawingFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,5" Margin="0,0,5,0"/><Button Content="Radera" Command="{Binding DataContext.DeleteDrawingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="8,5"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
        </Grid></Border>
        <TextBlock Text="{DynamicResource SectionComponents}" FontSize="20" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,12"><Button Content="{DynamicResource ImportBluebeamXml}" Command="{Binding ImportBluebeamXmlCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/><Button Content="{DynamicResource ExportExcel}" Command="{Binding ExportExcelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="{DynamicResource ExportCsv}" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel>
        <UniformGrid Columns="3" Margin="0,0,0,12"><Border Style="{StaticResource ModernCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="{DynamicResource TotalDuctMeters}"/><TextBlock Text="{Binding TotalDuctMeters, StringFormat={}{0:N1} m}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource ModernCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="{DynamicResource TotalDetailsCount}"/><TextBlock Text="{Binding TotalDetailsCount, StringFormat={}{0:N0} st}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border><Border Style="{StaticResource ModernCard}"><StackPanel><TextBlock Text="{DynamicResource TotalEquipmentCount}"/><TextBlock Text="{Binding TotalEquipmentCount, StringFormat={}{0:N0} st}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid>
        <Border Style="{StaticResource ModernCard}" Padding="0" Height="300"><DataGrid ItemsSource="{Binding SummaryItems}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="160"/><DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="Dimension / Beteckning" Binding="{Binding DimensionOrCode}" Width="190"/><DataGridTextColumn Header="Mängd" Binding="{Binding Quantity, StringFormat=N1}" Width="110"/><DataGridTextColumn Header="Enhet" Binding="{Binding Unit}" Width="80"/><DataGridTextColumn Header="Ritningsreferenser" Binding="{Binding SheetReferences}" Width="220"/></DataGrid.Columns></DataGrid></Border>
    </StackPanel></ScrollViewer>
</UserControl>