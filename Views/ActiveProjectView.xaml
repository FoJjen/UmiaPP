<UserControl x:Class="UmiaPP.Views.ActiveProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UmiaPP.Views">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button Content="{DynamicResource BackToProjects}" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left"/>
            <StackPanel Margin="18,0,0,0"><TextBlock Text="{Binding Project.Name}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding Project.ProjectNumber}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
        </DockPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="{DynamicResource TabOverview}"><views:OverviewTabView DataContext="{Binding OverviewTab}"/></TabItem>
            <TabItem Header="{DynamicResource TabLube}"><views:LubeCalculationTabView DataContext="{Binding LubeTab}"/></TabItem>
            <TabItem Header="{DynamicResource TabPurchase}"><views:PurchaseTabView DataContext="{Binding PurchaseTab}"/></TabItem>
            <TabItem Header="{DynamicResource TabAta}"><views:AtaTabView DataContext="{Binding AtaTab}"/></TabItem>
        </TabControl>
    </Grid>
</UserControl>