<UserControl x:Class="UmiaPP.Views.ActiveProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UmiaPP.Views">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,16" VerticalAlignment="Center">
            <Button Content="{DynamicResource ProjectsTitle}" Command="{Binding BackCommand}" Style="{StaticResource BreadcrumbButton}" ToolTip="{DynamicResource BackToProjects}"/>
            <TextBlock Text="&#x203A;" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="("/><Run Text="{Binding Project.ProjectNumber, Mode=OneWay}"/><Run Text=")"/></TextBlock>
            <TextBlock Text="&#x203A;" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding SelectedItem.Header, ElementName=ProjectNavigation}" VerticalAlignment="Center"/>
        </WrapPanel>
        <TabControl x:Name="ProjectNavigation" Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Style="{StaticResource SidebarTabControl}">
            <TabItem Header="{DynamicResource TabOverview}"><views:OverviewTabView DataContext="{Binding OverviewTab}"/></TabItem>
            <TabItem Header="{DynamicResource TabLube}"><views:LubeCalculationTabView DataContext="{Binding LubeTab}"/></TabItem>
            <TabItem Header="{DynamicResource TabPurchase}"><views:PurchaseTabView DataContext="{Binding PurchaseTab}"/></TabItem>
            <TabItem Header="{DynamicResource TabAta}"><views:AtaTabView DataContext="{Binding AtaTab}"/></TabItem>
            <TabItem Header="{DynamicResource TabInspection}"><views:InspectionTabView DataContext="{Binding InspectionTab}"/></TabItem>
        </TabControl>
    </Grid>
</UserControl>