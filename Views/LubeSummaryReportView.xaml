<UserControl x:Class="UmiaPP.Views.LubeSummaryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Arial" FontSize="11" Foreground="Black" Background="White">
    <UserControl.Resources>
        <Style x:Key="Cell" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="InputCell" TargetType="Border" BasedOn="{StaticResource Cell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInput}" Value="True">
                    <Setter Property="Background" Value="#99CCFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                <DataTrigger Binding="{Binding IsTotal}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ItemsControl ItemsSource="{Binding ReportSections}" Width="760" HorizontalAlignment="Left" Margin="12">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Margin="0,0,0,3">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Title}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border BorderBrush="Black" BorderThickness="1,1,0,0">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="19">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="94"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource InputCell}">
                                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasList}" Value="True"><Setter Property="Grid.ColumnSpan" Value="1"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Label}"/>
                                        </Border>
                                        <Border Grid.Column="1">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource InputCell}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasList}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding List}"/>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource InputCell}"><TextBlock Text="{Binding Quantity}" TextAlignment="Right"/></Border>
                                        <Border Grid.Column="3" Style="{StaticResource InputCell}"><TextBlock Text="{Binding Rate}" TextAlignment="Right"/></Border>
                                        <Border Grid.Column="4" Style="{StaticResource Cell}"><TextBlock Text="{Binding Net}" TextAlignment="Right"/></Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
